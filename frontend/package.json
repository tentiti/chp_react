{
  "name": "chpreact",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "canvas-capture": "^2.1.1",
    "gif.js": "^0.2.0",
    "gifshot": "^0.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "react-scripts": "^3.0.1",
    "recordrtc": "^5.6.2",
    "three": "^0.167.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  },
  "scripts": {
    "start": "concurrently \"npm run start-react\" \"npm run start-backend\"",
    "start-react": "HTTPS=true react-scripts start --cwd frontend",
    "build": "react-scripts build --cwd frontend",
    "start-backend": "cd ../backend && source .venv/bin/activate && export FLASK_APP=$(pwd)/run_app.py && flask run"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8000"
}
